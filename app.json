{
  "expo": {
    "name": "Mocktail Finder",
    "slug": "mocktail-finder",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mocktailfinder",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#01A6AF"
    },
    "ios": {
      "bundleIdentifier": "com.filonexperiencedesign.mocktailfinder",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.filonexperiencedesign.mocktailfinder",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#01A6AF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Mocktail Finder uses your photo library only to attach a picture to a recipe you create. Photos stay on your device.",
          "cameraPermission": "Mocktail Finder uses the camera only to take a picture for a recipe you create. Photos stay on your device.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "b9fdacfd-8320-4064-8684-0caa86509823"
      }
    },
    "owner": "filon-experience-design"
  }
}
